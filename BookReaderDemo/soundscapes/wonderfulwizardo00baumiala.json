    },
    "whistle": {
      "src": "https://cdn.freesound.org/previews/218/218386_3299593-hq.mp3",
      "gain": 1.2,
      "credit": "\"Whistling Wind.wav\" by Motion_S, CC0, https://freesound.org/people/Motion_S/sounds/218386/"
    },
    "running": {
      "src": "https://cdn.freesound.org/previews/816/816777_17552599-hq.mp3",
