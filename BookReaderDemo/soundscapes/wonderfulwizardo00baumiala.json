      "loopStart": 0.4,
      "gain": 0.6,
      "credit": "\"run in mud 2 edit\" by Luisa_Sanchez, CC0, https://freesound.org/people/Luisa_Sanchez/sounds/816777/"
    },
    "yelp": {
      "src": "https://cdn.freesound.org/previews/452/452180_612689-hq.mp3",
      "start": 0.7,
      "gain": 0.7,
      "credit": "\"bark yelp dog small int.flac\" by kyles, CC0, https://freesound.org/people/kyles/sounds/452180/"
    },
    "trapdoor": {
      "src": "https://cdn.freesound.org/previews/422/422434_6613494-hq.mp3",
      "gain": 0.8,
      "credit": "\"trap door open .wav\" by BehanSean, CC0, https://freesound.org/people/BehanSean/sounds/422434/"
    }
  },
  "cues": [
    {
      "at": { "pageIndex": 17, "quote": "low wail on the wind" },
      "actions": [{ "action": "play", "sound": "prairieWind", "volume": 0.3, "fade": 4 }]
    },
    {
      "at": { "pageIndex": 17, "quote": "bowed in waves before the coming storm", "position": "end" },
      "actions": [{ "action": "volume", "sound": "prairieWind", "volume": 0.5, "fade": 3 }]
    },
    {
      "at": { "pageIndex": 17, "quote": "sharp whistling in the air" },
      "actions": [
        { "action": "play", "sound": "whistle", "volume": 0.7 },
        { "action": "play", "sound": "whistle", "volume": 0.4, "delay": 2.5 }
      ]
    },
    {
      "at": { "pageIndex": 17, "quote": "ripples in the grass coming from that direction also", "position": "end" },
      "actions": [{ "action": "volume", "sound": "prairieWind", "volume": 0.65, "fade": 2 }]
    },
    {
      "at": { "pageIndex": 17, "quote": "a cyclone coming, Em" },
      "actions": [{ "action": "css", "class": "stormsky" }]
    },
    {
      "at": { "pageIndex": 17, "quote": "he ran toward the sheds" },
      "actions": [
        { "action": "play", "sound": "running", "volume": 0.8, "fade": 0.2 },
        { "action": "volume", "sound": "running", "volume": 0, "fade": 4, "delay": 0.8 },
        { "action": "stop", "sound": "running", "delay": 5 }
      ]
    },
    {
      "at": { "pageIndex": 17, "quote": "run for the cellar" },
      "actions": [{ "action": "volume", "sound": "prairieWind", "volume": 0.85, "fade": 1.5 }]
    },
    {
      "at": { "pageIndex": 17, "quote": "jumped out of Dorothy's arms and hid under the bed" },
      "actions": [{ "action": "play", "sound": "yelp" }]
    },
    {
      "at": { "pageIndex": 17, "quote": "threw open the trap-door" },
      "actions": [{ "action": "play", "sound": "trapdoor" }]
    },
    {
      "at": { "pageIndex": 17, "quote": "great shriek from the wind" },
      "actions": [{ "action": "play", "sound": "howl", "volume": 1, "fade": 1.5 }]
    },
    {
      "at": { "pageIndex": 17, "quote": "the house shook so hard" },
      "actions": [
        { "action": "play", "sound": "houseCreak", "volume": 0.9, "fade": 0.3 },
        { "action": "css", "class": "shake", "duration": 2.5 }
      ]
    },
    {
      "at": { "pageIndex": 17, "quote": "whirled around two or three times" },
      "actions": [
        { "action": "volume", "sound": "houseCreak", "volume": 1, "fade": 1 },
        { "action": "css", "class": "shake", "duration": 2.5 }
      ]
    },
    {
      "at": { "pageIndex": 17, "quote": "rose slowly through the air" },
      "actions": [{ "action": "css", "class": "rising" }]
    },
    {
      "at": { "pageIndex": 19, "quote": "Dorothy soon closed her eyes and fell fast asleep", "position": "end" },
      "actions": [
        { "action": "volume", "sound": "howl", "volume": 0.3, "fade": 6 },
        { "action": "volume", "sound": "houseCreak", "volume": 0.35, "fade": 6 },
        { "action": "volume", "sound": "prairieWind", "volume": 0.3, "fade": 6 }
      ]
    }
  ]
}
