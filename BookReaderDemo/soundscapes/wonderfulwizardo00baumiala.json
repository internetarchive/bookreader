  "effects": {
    "stormsky": { "css": ["& { background-color: #1d2127; }"] },
    "shake": { "css": [
      "@keyframes soundscape-shake {",
      "  0% { translate: 0 0; rotate: 0deg; }",
      "  6% { translate: -5px 2px; rotate: -0.6deg; }",
      "  11% { translate: 4px -3px; rotate: 0.4deg; }",
      "  19% { translate: -2px 1px; rotate: 0deg; }",
      "  24% { translate: 6px 2px; rotate: 0.7deg; }",
      "  33% { translate: -4px -2px; rotate: -0.3deg; }",
      "  41% { translate: 1px 3px; rotate: 0.2deg; }",
      "  47% { translate: -6px 0; rotate: -0.8deg; }",
      "  58% { translate: 3px -2px; rotate: 0.3deg; }",
      "  66% { translate: -2px 2px; rotate: -0.2deg; }",
      "  74% { translate: 4px 1px; rotate: 0.5deg; }",
      "  85% { translate: -1px -1px; rotate: 0deg; }",
      "  92% { translate: 2px 0; rotate: 0.2deg; }",
      "  100% { translate: 0 0; rotate: 0deg; }",
      "}",
      "& .BRfooter { animation: soundscape-shake 2.5s steps(1, end); }"
    ] },
    "rising": { "css": ["& .BRfooter { scale: 1.06; filter: drop-shadow(0 -6px 14px rgba(0, 0, 0, 0.7)); }"] },
    "higher": { "css": ["&.soundscape-rising .BRfooter { scale: 1.1; filter: drop-shadow(0 -10px 22px rgba(0, 0, 0, 0.8)); }"] },
    "lurch": { "css": [
      "@keyframes soundscape-lurch {",
      "  0% { translate: 0 0; rotate: 0deg; }",
      "  10% { translate: -10px 4px; rotate: -2.2deg; }",
      "  28% { translate: 6px -2px; rotate: 1.2deg; }",
      "  46% { translate: -3px 1px; rotate: -0.6deg; }",
      "  68% { translate: 1px 0; rotate: 0.3deg; }",
      "  100% { translate: 0 0; rotate: 0deg; }",
      "}",
      "& .BRfooter { animation: soundscape-lurch 1.6s steps(1, end); }"
    ] },
    "sway": { "css": [
      "@keyframes soundscape-sway {",
      "  0%, 100% { translate: -4px 0; rotate: -0.8deg; }",
      "  50% { translate: 4px 0; rotate: 0.8deg; }",
      "}",
      "& .BRfooter { animation: soundscape-sway 4.5s ease-in-out infinite; }"
    ] },
    "sleep": { "css": ["& { background-color: #0b0c0f; }"] },
    "landed": { "css": ["& .BRfooter { transition: scale 0.35s ease-in, filter 0.6s; }"] },
    "sunshine": { "css": ["& { background-color: #4a3d22; }"] },
    "oz": { "css": ["& { background-color: #1e3524; }"] },
    "shadow": { "css": ["& { background-color: #0f1a12; transition: background-color 0.8s; }"] },
    "silver": { "css": ["& { background-color: #3a4446; transition: background-color 0.8s; }"] },
    "glow": {
      "css": [
        "@keyframes soundscape-glow-drift {",
        "  0% { background-position: 0% 0%, 100% 100%, 50% 0%; }",
        "  50% { background-position: 60% 40%, 30% 70%, 0% 100%; }",
        "  100% { background-position: 100% 100%, 0% 0%, 100% 50%; }",
        "}",
        ".BookReader::before {",
        "  content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;",
        "  background-image: radial-gradient(circle at center, rgba(168, 85, 247, 0.55), transparent 45%), radial-gradient(circle at center, rgba(236, 72, 153, 0.4), transparent 40%), radial-gradient(circle at center, rgba(99, 102, 241, 0.45), transparent 50%);",
        "  background-size: 140% 140%, 120% 120%, 160% 160%; background-repeat: no-repeat;",
        "  opacity: 0; transition: opacity 1.5s ease-out;",
        "  animation: soundscape-glow-drift 3s ease-in-out infinite alternate;",
        "}",
        "&::before { opacity: 1; transition: opacity 0.4s ease-in; }",
        "& { background-color: #1c1530; transition: background-color 0.4s; }"
      ]
    }
  },
